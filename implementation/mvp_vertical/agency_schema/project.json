  "views": {
    "cockpit_front": {
      "purpose": "Compact Project identity used on the card recto.",
      "fields": ["code","display_name","phase","location","status","tags"]
    },
    "cockpit_back": {
      "purpose": "Business information shown on the Project card verso. Consequential values are ProjectClaim projections.",
      "fields": ["code","phase","location","programme_summary","architectural_style","budget","montant_marche","surface_terrain","surface_existante","surface_projet","emprise","parcelles","plu_zone","permit_number","permit_date","reception_date","erp_type"]
    },
    "edit": {
      "purpose": "Generic human Project editor. Source-backed claim projections are not editable as plain Project attributes; Contacts use their dedicated editor.",
      "fields": ["code","display_name","description","status","phase","location","tags","programme_summary","architectural_style","agency_notes"]
    },
    "notion": {
      "purpose": "Definitive collaborative projection plus PostgreSQL revision for sync conflict detection. Claims may be projected read-only; archives and ChangeCandidates stay outside Notion.",
      "fields": ["code","display_name","status","phase","location","contacts","tags","programme_summary","architectural_style","budget","montant_marche","surface_terrain","surface_existante","surface_projet","emprise","parcelles","plu_zone","permit_number","permit_date","reception_date","erp_type","revision"]
    },
    "hermes_context": {
      "purpose": "Project identity, descriptive attributes and claim projections eligible for scoped runtime materialization; inclusion is not mutation authority.",
      "fields": ["project_id","code","display_name","description","status","phase","location","contacts","tags","programme_summary","architectural_style","agency_notes","budget","montant_marche","surface_terrain","surface_existante","surface_projet","emprise","parcelles","plu_zone","permit_number","permit_date","reception_date","erp_type","revision"]
