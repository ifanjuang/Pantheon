FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PANTHEON_POLICY_HOST=0.0.0.0 \
    PANTHEON_POLICY_PORT=8000

RUN groupadd --system pantheon \
    && useradd --system --gid pantheon --home-dir /nonexistent --shell /usr/sbin/nologin pantheon

WORKDIR /opt/pantheon

COPY mcp-server /opt/pantheon/mcp-server
RUN python -m pip install --upgrade pip \
    && python -m pip install "/opt/pantheon/mcp-server[http]"

USER pantheon:pantheon

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=3).read()"]

ENTRYPOINT ["pantheon-policy-api"]
