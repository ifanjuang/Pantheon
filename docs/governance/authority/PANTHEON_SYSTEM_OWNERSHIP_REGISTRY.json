{
  "registry_id": "pantheon.system_ownership",
  "revision": 4,
  "status": "candidate_support_registry",
  "authority_note": "This registry separates semantic, implementation, state-transition, persistence, runtime and projection ownership for architecture convergence. Owner identities name responsibilities, not repositories or filesystem zones. It does not promote a candidate, authorize execution, admit Evidence, approve a binding or replace the master authority index.",
  "owners": {
    "Pantheon governance": {
      "role": "semantic_governance",
      "owns": [
        "doctrine",
        "governed concepts",
        "schemas",
        "statuses",
        "Evidence semantics",
        "scope",
        "approvals",
        "Capability Slots"
      ]
    },
    "Pantheon implementation": {
      "role": "governed_implementation",
      "owns": [
        "PostgreSQL persistence",
        "APIs",
        "governed state transitions",
        "executable projections",
        "bounded adapters",
        "integration seams"
      ]
    },
    "Hermes/external runtime": {
      "role": "runtime",
      "owns": [
        "execution",
        "tools",
        "provider routing",
        "runtime-local state"
      ]
    },
    "Pantheon Cockpit": {
      "role": "governed_projection",
      "owns": [
        "governed Cards",
        "navigation projections",
        "status projections",
        "Evidence-gap projections",
        "review surfaces",
        "decision surfaces"
      ]
    }
  },
  "boundary_rules": [
    "installed != approved",
    "healthy != safe",
    "runtime_success != Evidence",
    "retrieved != truth",
    "binding_selected != dependency_adopted",
    "activated != task_authorized",
    "UI status != authorization",
    "projection != persistence",
    "folder != governed identity",
    "repository co-location != authority transfer"
  ],
  "concepts": [
    {
      "id": "project_claim",
      "label": "ProjectClaim",
      "semantic_owner": "Pantheon governance",
      "implementation_owner": "Pantheon implementation",
      "transition_owner": "Pantheon implementation",
      "persistence_owner": "Pantheon implementation",
      "projection_owner": "Pantheon Cockpit",
      "patterns": [
        "\\bproject[_ -]?claim\\b"
      ],
      "max_identity_implementations": 4
    },
    {
      "id": "information",
      "label": "Information lifecycle",
      "semantic_owner": "Pantheon governance",
