#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/release.env"
MCP_VERSION="${RELEASE_HINDSIGHT_PROJECT_MCP_VERSION:?release.env missing router MCP version}"
SOURCE_ROOT="$REPO_ROOT/implementation/hermes/hindsight_project_router"
APP_ROOT="/opt/pantheon-node/hindsight-project-router"
UV="/opt/pantheon-node/uv/bin/uv"
SERVICE_USER="pantheon-hindsight-router"
HINDSIGHT_URL="${HINDSIGHT_PROJECT_URL:-http://127.0.0.1:8888}"
APPLY=0
ENABLE=0
MODE="project"

log() { printf '[hindsight-project-router] %s\n' "$*"; }
die() { printf '[hindsight-project-router] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage:
  deployment/ubuntu/configure-hindsight-project-router-local --check
  sudo deployment/ubuntu/configure-hindsight-project-router-local --apply [--enable]
  deployment/ubuntu/configure-hindsight-project-router-local --knowledge --check
  sudo deployment/ubuntu/configure-hindsight-project-router-local --knowledge --apply [--enable]

Installs an authenticated loopback MCP service that exposes only project-scoped
Project-platform recall. It always applies source:project-sync, one scope:project:* tag and
tags_match=all_strict, and fails closed if Hindsight returns an unscoped result.
It never exposes bank-wide recall or a Hindsight write operation.

--knowledge installs a second, independent instance for the knowledge vault
(standards, guides, insurer recommendations, glossaries). It applies only the
knowledge source tag (default source:knowledge) and an optional folder tag, with
tags_match=all_strict, on 127.0.0.1:8023 with its own bearer token. Bank and
source are deployment values: set HINDSIGHT_KNOWLEDGE_BANK_ID and
HINDSIGHT_KNOWLEDGE_SOURCE_KIND from the local installation bindings.
USAGE
}

while (($#)); do
  case "$1" in
    --check) APPLY=0 ;;
    --apply) APPLY=1 ;;
    --enable) ENABLE=1 ;;
    --knowledge) MODE="knowledge" ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

if [[ "$MODE" == knowledge ]]; then
  INSTANCE="pantheon-hindsight-knowledge-router"
  STATE_ROOT="/srv/pantheon/hindsight-knowledge-router"
  PORT=8023
  HINDSIGHT_BANK_ID="${HINDSIGHT_KNOWLEDGE_BANK_ID:-KNOWLEDGE}"
  HINDSIGHT_SOURCE_KIND="${HINDSIGHT_KNOWLEDGE_SOURCE_KIND:-knowledge}"
  DESCRIPTION="Knowledge-vault Hindsight MCP router for Hermes"
else
  INSTANCE="pantheon-hindsight-project-router"
  STATE_ROOT="/srv/pantheon/hindsight-project-router"
  PORT=8022
  HINDSIGHT_BANK_ID="${HINDSIGHT_PROJECT_BANK_ID:-PROJECTS}"
  HINDSIGHT_SOURCE_KIND="${HINDSIGHT_PROJECT_SOURCE_KIND:-project-sync}"
  DESCRIPTION="Project-scoped Hindsight MCP router for Hermes"
fi
TOKEN_FILE="$STATE_ROOT/token"
UNIT_FILE="/etc/systemd/system/$INSTANCE.service"

[[ -f "$SOURCE_ROOT/hindsight_project_recall.py" ]] || die "project recall core is missing"
[[ -f "$SOURCE_ROOT/hindsight_project_mcp.py" ]] || die "project MCP service is missing"

if ((APPLY == 0)); then
  [[ "$ENABLE" == 0 ]] || die "--enable requires --apply"
  [[ -x "$APP_ROOT/.venv/bin/python" ]] && log "isolated runtime present" \
    || log "isolated runtime absent"
  [[ -f "$TOKEN_FILE" ]] && log "bearer token present (not displayed)" \
    || log "bearer token absent"
  if systemctl is-active --quiet "$INSTANCE.service"; then
    log "loopback service active"
  else
    log "loopback service inactive"
  fi
  log "mode=$MODE bank=$HINDSIGHT_BANK_ID source=$HINDSIGHT_SOURCE_KIND url=$HINDSIGHT_URL port=$PORT"
  log "check only; no state changed"
  exit 0
fi

[[ ${EUID:-$(id -u)} -eq 0 ]] || die "--apply requires root"
[[ -x "$UV" ]] || die "managed uv is missing: $UV"
id -u "$SERVICE_USER" >/dev/null 2>&1 \
  || useradd --system --home-dir "$APP_ROOT" --shell /usr/sbin/nologin "$SERVICE_USER"

install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0755 "$APP_ROOT"
install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0750 "$STATE_ROOT"
install -m 0644 "$SOURCE_ROOT/hindsight_project_recall.py" "$APP_ROOT/hindsight_project_recall.py"
install -m 0644 "$SOURCE_ROOT/hindsight_project_mcp.py" "$APP_ROOT/hindsight_project_mcp.py"
if [[ ! -x "$APP_ROOT/.venv/bin/python" ]]; then
  "$UV" venv --python /usr/bin/python3 "$APP_ROOT/.venv"
fi
"$UV" pip install --python "$APP_ROOT/.venv/bin/python" "mcp==$MCP_VERSION"
chown -R "$SERVICE_USER:$SERVICE_USER" "$APP_ROOT"
chmod -R a+rX "$APP_ROOT"

if [[ ! -e "$TOKEN_FILE" ]]; then
  umask 077
  openssl rand -hex 32 > "$TOKEN_FILE"
fi
chown "$SERVICE_USER:$SERVICE_USER" "$TOKEN_FILE"
chmod 0600 "$TOKEN_FILE"

cat > "$UNIT_FILE" <<EOF_UNIT
[Unit]
Description=$DESCRIPTION
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$SERVICE_USER
Group=$SERVICE_USER
WorkingDirectory=$APP_ROOT
Environment=HINDSIGHT_PROJECT_URL=$HINDSIGHT_URL
Environment=HINDSIGHT_PROJECT_BANK_ID=$HINDSIGHT_BANK_ID
Environment=HINDSIGHT_PROJECT_SOURCE_KIND=$HINDSIGHT_SOURCE_KIND
Environment=HINDSIGHT_PROJECT_TOKEN_FILE=$TOKEN_FILE
Environment=HINDSIGHT_PROJECT_MCP_PORT=$PORT
Environment=HINDSIGHT_ROUTER_MODE=$MODE
ExecStart=$APP_ROOT/.venv/bin/python $APP_ROOT/hindsight_project_mcp.py --http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=$TOKEN_FILE

[Install]
WantedBy=multi-user.target
EOF_UNIT
chmod 0644 "$UNIT_FILE"
systemctl daemon-reload
if ((ENABLE == 1)); then
  systemctl enable "$INSTANCE.service"
  if systemctl is-active --quiet "$INSTANCE.service"; then
    systemctl restart "$INSTANCE.service"
  else
    systemctl start "$INSTANCE.service"
  fi
  log "enabled authenticated $MODE MCP on 127.0.0.1:$PORT"
else
  log "staged but not activated; rerun with --apply --enable after review"
fi
log "Hermes binding remains a separate explicit --with-vault-adapter --bind-local-mcp step"
