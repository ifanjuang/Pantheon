#!/usr/bin/env bash
set -Eeuo pipefail

STATE_ROOT="${PANTHEON_STATE_ROOT:-/srv/pantheon}"
HERMES_ROOT="$STATE_ROOT/hermes"
PROFILE="pantheon-governed"
APPLY=0
RESTART=0
ROUTE_WHATSAPP=0
WHATSAPP_CHAT_ID=""
ALL_AUTHORIZED_WHATSAPP=0
BIND_LOCAL_MCP=0
CURATED_DEFAULT_SKILLS=0
VAULT_ADAPTER=0
ENABLE_CLARIFY=0
ENABLE_BOUNDED_DELEGATION=0
HERMES_USER="${HERMES_USER:-pantheon-hermes}"
HERMES_HOME="${HERMES_HOME:-/home/$HERMES_USER}"
HERMES_BIN="${HERMES_BIN:-$HERMES_HOME/.local/bin/hermes}"
HERMES_SKILLS_ROOT="${HERMES_SKILLS_ROOT:-$HERMES_ROOT/skills}"
CURATED_STAGE_ROOT=""
LOCAL_MCP_SELECTED=""
PANTHEON_POLICY_TOOLS_JSON='["classify_request","find_relevant_sources","route_governed_request","read_doctrine","explain_governance_structure","get_consultation_catalog","explain_architecture","get_capability_status","evaluate_preflight","prepare_task_contract_skeleton","prepare_evidence_pack_skeleton","plan_context_pack","validate_context_pack"]'
DOCLING_TOOLS_JSON='["is_document_in_local_cache","convert_document_into_docling_document","get_overview_of_document_anchors","search_for_text_in_document_anchors","get_text_of_document_item_at_anchor"]'
HINDSIGHT_PROJECT_TOOLS_JSON='["recall_project_memory","hindsight_project_list"]'
