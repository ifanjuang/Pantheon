  "$REPO_ROOT/templates/hermes/skills/contract-clause-review"
  "$REPO_ROOT/templates/hermes/skills/construction-cost-review"
  "$REPO_ROOT/templates/hermes/skills/construction-schedule-review"
  "$REPO_ROOT/templates/hermes/skills/external-commitment-guard"
  "$REPO_ROOT/templates/hermes/skills/pantheon-activity-projection"
  "$REPO_ROOT/templates/hermes/skills/pantheon-governed-method"
  "$REPO_ROOT/templates/hermes/skills/pantheon-request-intake"
  "$REPO_ROOT/templates/hermes/skills/site-report-review"
  "$REPO_ROOT/templates/hermes/skills/source-research"
  "$REPO_ROOT/templates/hermes/skills/technical-standard-review"
